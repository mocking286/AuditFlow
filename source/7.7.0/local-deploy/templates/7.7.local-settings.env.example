# JEAuditFlow 7.7 local runtime. The launcher creates protected credentials.
JEAUDITFLOW_DATABASE_MODE=native
MYSQL_DATABASE=jeauditflow_770
MYSQL_USER=jeauditflow770
DB_PORT=43324
MYSQL_VOLUME_NAME=jeauditflow_770_mysql_data
COMPOSE_PROJECT=jeauditflow770-local
AUDITFLOW_PORT=47683
AUDITFLOW_AI_PORT=47686
FILEANALYST_PORT=47684
JIRAFLOW_PORT=47685
AUDITFLOW_LAN_HOST=
AUDITFLOW_LAN_CIDR=
NODE_BIN=local-deploy/runtime/toolchains/node-v26.13.1-darwin-arm64/bin/node
JIRAFLOW_JAVA=local-deploy/runtime/toolchains/jdk-27.0.1.0.3.jdk/Contents/Home/bin/java
JEAUDITFLOW_POLARION_URL=
AUDITFLOW_ENABLE_POLARION_BRIDGE=0
# Local Jira REST channel: fixed loopback host, explicit project allowlist.
AUDITFLOW_JIRA_PORT=8080
AUDITFLOW_JIRA_PAT=
AUDITFLOW_JIRA_USERNAME=
AUDITFLOW_JIRA_PASSWORD=
AUDITFLOW_JIRA_PROJECT_KEYS=
# Microsoft Entra SSO: mapped identities retain their AuditFlow project roles.
AUDITFLOW_SSO_ENTRA_TENANT_ID=
AUDITFLOW_SSO_ENTRA_CLIENT_ID=
AUDITFLOW_SSO_ENTRA_CLIENT_SECRET=
AUDITFLOW_SSO_ENTRA_REDIRECT_URI=http://127.0.0.1:47683/api/auth/sso/callback
AUDITFLOW_SSO_ENTRA_USER_MAP='{}'
# Use outlook-desktop for this Mac's explicitly selected Outlook sender.
AUDITFLOW_MAIL_TRANSPORT=microsoft-graph
# Graph application mail requires an organizational mailbox and Mail.Send consent.
AUDITFLOW_MAIL_ENTRA_TENANT_ID=
AUDITFLOW_MAIL_ENTRA_CLIENT_ID=
AUDITFLOW_MAIL_ENTRA_CLIENT_SECRET=
AUDITFLOW_MAIL_FROM=
