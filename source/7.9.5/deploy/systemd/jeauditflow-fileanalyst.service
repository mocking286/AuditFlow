[Unit]
Description=JEAuditFlow 7.9.5 FileAnalyst attachment service
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=jeauditflow
Group=jeauditflow
WorkingDirectory=/opt/jeauditflow/7.9.5/fileanalyst
EnvironmentFile=/etc/jeauditflow/7.9.5.env
ExecStart=/opt/jeauditflow/node/bin/node server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/jeauditflow/7.9.5

[Install]
WantedBy=multi-user.target
