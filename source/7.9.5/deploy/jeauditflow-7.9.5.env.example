# JEAuditFlow 7.9.5 server configuration.
# Install as /etc/jeauditflow/7.9.5.env (owner root:jeauditflow, mode 640).
# Values in <...> must be supplied by the operator. Do not quote values: systemd
# reads this file literally. URL-encode reserved characters (@ : / ? # %) in
# the password parts of the mysql:// URLs.

NODE_ENV=production

# --- AuditFlow API + web client (loopback only; publish through nginx) ---
AUDITFLOW_PORT=47983
AUDITFLOW_SERVER_ROLE=collaboration
AUDITFLOW_WEB_CLIENT_ROOT=/opt/jeauditflow/7.9.5/client
AUDITFLOW_OUTPUT_DIR=/var/lib/jeauditflow/7.9.5/auditflow
AUDITFLOW_USER_DATA_DIR=/var/lib/jeauditflow/7.9.5/users
AUDITFLOW_DATA_DIR=/var/lib/jeauditflow/7.9.5/ops
AUDITFLOW_RELEASES_DIR=/var/lib/jeauditflow/7.9.5/releases
AUDITFLOW_MYSQL_URL=mysql://jeauditflow:<MYSQL_PASSWORD_URLENCODED>@127.0.0.1:43327/jeauditflow_795

# First start only: creates the administrator when the database has no accounts.
# 10-200 characters. Remove the password line after the first successful sign-in.
AUDITFLOW_BOOTSTRAP_ADMIN_EMAIL=<admin@example.com>
AUDITFLOW_ADMIN_NAME=<Administrator display name>
AUDITFLOW_BOOTSTRAP_ADMIN_PASSWORD=<initial admin password>

# --- FileAnalyst (separate systemd service, MySQL attachment storage) ---
FILEANALYST_PORT=47984
FILEANALYST_HOST=127.0.0.1
FILEANALYST_BASE_PATH=/fileanalyst
FILEANALYST_AUTOSTART=0
FILEANALYST_AUDITFLOW_AUTH_URL=http://127.0.0.1:47983/api/auth/me
FILEANALYST_AUDITFLOW_PROJECTS_URL=http://127.0.0.1:47983/api/projects
FILEANALYST_CLIENT_ROOT=/opt/jeauditflow/7.9.5/client/fileanalyst
FILEANALYST_STORAGE=mysql
FILEANALYST_REQUIRE_DATABASE=1
FILEANALYST_MYSQL_URL=mysql://jeauditflow:<MYSQL_PASSWORD_URLENCODED>@127.0.0.1:43327/jeauditflow_795
FILEANALYST_DATA_DIR=/var/lib/jeauditflow/7.9.5/fileanalyst
FILEANALYST_LOCAL_ONLY=0
FILEANALYST_LOCAL_PREVIEW=0
FILEANALYST_DESKTOP_MODE=0

# --- JiraFlow (started by the API; state stored in MySQL table jiraflow_state) ---
JIRAFLOW_AUTOSTART=1
JIRAFLOW_PORT=47985
JIRAFLOW_HOST=127.0.0.1
JIRAFLOW_ROOT=/opt/jeauditflow/7.9.5/jiraflow
JIRAFLOW_JAVA=/usr/bin/java
JIRAFLOW_DATA_DIR=/var/lib/jeauditflow/7.9.5/jiraflow
JIRAFLOW_USER=testuser
JIRAFLOW_STORAGE=mysql
JIRAFLOW_MYSQL_URL=jdbc:mysql://127.0.0.1:43327/jeauditflow_795?sslMode=DISABLED&allowPublicKeyRetrieval=true
JIRAFLOW_MYSQL_USER=jeauditflow
JIRAFLOW_MYSQL_PASSWORD=<MYSQL_PASSWORD>

# --- Reverse proxy (optional; only when nginx terminates HTTPS for a domain) ---
# AUDITFLOW_TRUSTED_PROXY_HOSTS=<auditflow.example.com>
# AUDITFLOW_TRUSTED_PROXY_SECRET=<random secret also set in nginx>

# --- Jira REST channel (optional). Jira must listen on this server's loopback. ---
# AUDITFLOW_JIRA_PORT=8080
# AUDITFLOW_JIRA_PROJECT_KEYS=<CEP,ABC>
# AUDITFLOW_JIRA_PAT=<personal access token>
# or: AUDITFLOW_JIRA_USERNAME=<user>  AUDITFLOW_JIRA_PASSWORD=<password>

# --- Microsoft Entra SSO / Graph mail (optional) ---
# AUDITFLOW_SSO_ENTRA_TENANT_ID=
# AUDITFLOW_SSO_ENTRA_CLIENT_ID=
# AUDITFLOW_SSO_ENTRA_CLIENT_SECRET=
# AUDITFLOW_SSO_ENTRA_REDIRECT_URI=https://<auditflow.example.com>/api/auth/sso/callback
# AUDITFLOW_MAIL_TRANSPORT=microsoft-graph
# AUDITFLOW_MAIL_ENTRA_TENANT_ID=
# AUDITFLOW_MAIL_ENTRA_CLIENT_ID=
# AUDITFLOW_MAIL_ENTRA_CLIENT_SECRET=
# AUDITFLOW_MAIL_FROM=

# --- AI provider (optional; disabled unless a key is set) ---
# AUDITFLOW_MODEL_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
