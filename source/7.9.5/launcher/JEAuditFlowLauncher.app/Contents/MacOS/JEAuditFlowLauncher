  else what="创建数据库 $DB_NAME，并在其中创建 $VERSION 数据表"; fi
  if gui; then
    [ "$(dialog "第一次在这个连接上运行 JEAuditFlow $VERSION：
$DB_LABEL（$DB_USER@$DB_HOST:$DB_PORT）

启动器将$what。只执行 CREATE … IF NOT EXISTS，不删除、不修改已有的库和数据。" "创建并启动" "取消")" = "创建并启动" ] || exit 0
