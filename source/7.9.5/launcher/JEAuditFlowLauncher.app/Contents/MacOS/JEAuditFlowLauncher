health_json() { curl -fsS -m 5 "http://127.0.0.1:$API_PORT/api/health" 2>/dev/null; }

stack_healthy() {
  local h
  h="$(health_json)" || return 1
  case "$h" in *'"status":"ok"'*) ;; *) return 1 ;; esac
  case "$h" in *'"fileAnalyst":{"available":true,"healthy":true'*) ;; *) return 1 ;; esac
  case "$h" in *'"jiraFlow":{"available":true,"healthy":true'*) ;; *) return 1 ;; esac
}

pid_alive() { [ -f "$RUN_DIR/$1.pid" ] && kill -0 "$(cat "$RUN_DIR/$1.pid")" 2>/dev/null; }

# PID listening on a port whose working directory or command line belongs to this installation.
owned_listener() {
  local pid where
  command -v lsof >/dev/null 2>&1 || return 0
  for pid in $(lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null); do
    where="$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1) $(ps -o command= -p "$pid" 2>/dev/null)"
    case "$where" in *"$PROJECT_ROOT"*) printf '%s\n' "$pid"; return 0 ;; esac
  done
}

start_service() {
  local name="$1" dir="$2"; shift 2
  pid_alive "$name" && return 0
  (cd "$dir" && exec nohup "$@") >>"$LOG_DIR/$name.log" 2>&1 </dev/null &
  echo $! >"$RUN_DIR/$name.pid"
}

stop_service() {
  local name="$1" port="${2:-}" pid="" _
  [ -f "$RUN_DIR/$name.pid" ] && pid="$(cat "$RUN_DIR/$name.pid")"
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then pid="$( [ -n "$port" ] && owned_listener "$port")"; fi
  if [ -n "$pid" ] && kill "$pid" 2>/dev/null; then
    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    kill -9 "$pid" 2>/dev/null
    log "已停止 $name"
  fi
  rm -f "$RUN_DIR/$name.pid"
}

stop_stack() {
  stop_service api "$API_PORT"
  stop_service jiraflow "$JF_PORT"
  stop_service fileanalyst "$FA_PORT"
  rm -f "$RUN_DIR/lan-host"
}

wait_for() {
  local label="$1" url="$2" seconds="$3" _
  for _ in $(seq 1 "$seconds"); do curl -fsS -m 3 "$url" >/dev/null 2>&1 && return 0; sleep 1; done
  fail "$label 未能在 ${seconds} 秒内就绪，详见 $LOG_DIR"
}

ensure_ports_free() {
  local entry name port owner
  for entry in "api:$API_PORT" "jiraflow:$JF_PORT" "fileanalyst:$FA_PORT"; do
    name="${entry%%:*}"; port="${entry#*:}"
    port_open "$port" || continue
    stop_service "$name" "$port"
    port_open "$port" || continue
    owner="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | awk 'NR == 2 { print $1 "（PID " $2 "）" }')"
    fail "端口 $port 已被其他程序占用${owner:+：$owner}。请先关闭它（例如 7.x 测试台启动的旧服务）再打开启动器。"
  done
}

start_stack() {
  ensure_root
  load_ports
  if stack_healthy; then
    detect_lan
    if [ ! -f "$RUN_DIR/lan-host" ] || [ "$LAN_HOST" = "$(cat "$RUN_DIR/lan-host")" ]; then
      ALREADY_RUNNING=1
      log "JEAuditFlow $VERSION 已在运行：$WORKBENCH_URL"
      return 0
    fi
    log "Wi-Fi 地址已变化（$(cat "$RUN_DIR/lan-host") → ${LAN_HOST:-无}），重启服务以更新局域网访问"
    stop_stack
  fi
  find_node || fail "需要 Node.js $NODE_MIN 或更高版本。请在终端执行：brew install node
（或从 https://nodejs.org 安装 26.x），然后重新打开启动器。"
  find_java || fail "JiraFlow 需要 Java $JAVA_MIN 或更高版本。请在终端执行：brew install openjdk@21"
  ensure_ports_free
  admin_settings
  resolve_database
  ensure_app_database
  detect_lan
  export_runtime_env
  notify "正在启动 JEAuditFlow $VERSION（数据库：$DB_LABEL）…"
  start_service fileanalyst "$PROJECT_ROOT/fileanalyst" "$NODE_BIN" "$PROJECT_ROOT/fileanalyst/server.mjs"
  wait_for FileAnalyst "http://127.0.0.1:$FA_PORT/api/health" 60
  start_service api "$PROJECT_ROOT/server" "$NODE_BIN" "$PROJECT_ROOT/server/server.mjs" serve
  printf '%s\n' "$LAN_HOST" >"$RUN_DIR/lan-host"
  wait_for "AuditFlow API" "http://127.0.0.1:$API_PORT/api/health" 90
  local _
  for _ in $(seq 1 60); do stack_healthy && break; sleep 1; done
  stack_healthy || fail "服务已启动，但 FileAnalyst 或 JiraFlow 健康检查未通过，详见 $LOG_DIR"
  if [ "$SHOW_ADMIN" = 1 ]; then
    printf '工作台：%s\n账号：%s\n初始密码：%s\n' "$WORKBENCH_URL" "$ADMIN_EMAIL" "$ADMIN_PASSWORD" >"$ADMIN_FILE"
    chmod 600 "$ADMIN_FILE"
  fi
  log "JEAuditFlow $VERSION 已启动：$WORKBENCH_URL${LAN_HOST:+；局域网 $(lan_url)}"
}

status() {
  local h lan
  lan="$(cat "$RUN_DIR/lan-host" 2>/dev/null)"
  printf 'JEAuditFlow %s\n程序目录：%s\n数据库：%s\n配置：%s\n日志：%s\n' "$VERSION" \
    "$( [ -f "$ROOT_FILE" ] && cat "$ROOT_FILE" || echo 未设置)" \
    "$(conf_get DB_LABEL) $(conf_get DB_USER)@$(conf_get DB_HOST):$(conf_get DB_PORT)/$(conf_get DB_NAME)" "$SETTINGS" "$LOG_DIR"
  if h="$(health_json)"; then
    printf 'API：运行中 %s\n' "$WORKBENCH_URL"
    if stack_healthy; then echo "FileAnalyst/JiraFlow：正常"; else echo "FileAnalyst/JiraFlow：异常"; fi
    [ -n "$lan" ] && printf '局域网：http://%s:%s/\n' "$lan" "$API_PORT"
  else
    echo "API：未运行"
  fi
  return 0
}

choose_database() {
  local candidates line index=0 chosen score source secret host port user database label
  ensure_root
  load_ports
  find_node || fail "需要 Node.js $NODE_MIN 或更高版本"
  candidates="$(db_candidates)"
  [ -n "$candidates" ] || fail "没有在 TablePlus 或项目配置中找到本机 MySQL 连接。"
  set --
  while IFS= read -r line; do
    index=$((index + 1))
    set -- "$@" "$index. $(IFS="$TAB"; set -f; candidate_display $line)"
  done <<EOF
$candidates
EOF
  chosen="$(choose_from_list "选择 JEAuditFlow $VERSION 使用的数据库连接：" "$@")"
  [ -n "$chosen" ] || exit 0
  line="$(printf '%s\n' "$candidates" | sed -n "${chosen%%.*}p")"
  [ -n "$line" ] || fail "无效的选择：$chosen"
  IFS="$TAB" read -r score source secret host port user database label <<EOF
$line
EOF
  use_candidate "$score" "$source" "$secret" "$host" "$port" "$user" "$database" "$label"
  try_database || fail "$TRY_REASON"
  save_database
  if stack_healthy; then
    log "数据库已切换；正在重启服务"
    stop_stack
    main_gui
  fi
}

main_gui() {
  local lan choice
  ALREADY_RUNNING=0
  start_stack
  open_url "$WORKBENCH_URL"
  lan="$(lan_url)"
  if [ "$SHOW_ADMIN" = 1 ]; then
    dialog "JEAuditFlow $VERSION 已在本机启动，工作台已在浏览器中打开。

管理员账号：$ADMIN_EMAIL
初始密码：$ADMIN_PASSWORD
（保存在 $ADMIN_FILE）
${lan:+$NL同一 Wi-Fi 的同事访问：$lan}" "好" >/dev/null
    return 0
  fi
  if [ "$ALREADY_RUNNING" = 1 ]; then
    if [ -n "$lan" ]; then
      choice="$(dialog -t 20 "JEAuditFlow $VERSION 正在本机运行，已打开工作台。
本机：$WORKBENCH_URL
同一 Wi-Fi 的同事：$lan" "好" "复制局域网地址" "停止服务")"
    else
      choice="$(dialog -t 20 "JEAuditFlow $VERSION 正在本机运行，已打开工作台。
本机：$WORKBENCH_URL" "好" "停止服务")"
    fi
    case "$choice" in
      "停止服务") stop_stack; notify "已停止 JEAuditFlow $VERSION（数据库保持运行）" ;;
      "复制局域网地址") printf '%s' "$lan" | pbcopy 2>/dev/null; notify "已复制 $lan" ;;
    esac
    return 0
  fi
  notify "JEAuditFlow $VERSION 已启动${lan:+，同一 Wi-Fi 的同事可访问 $lan}"
}

if [ "${JEAUDITFLOW_LAUNCHER_SOURCE_ONLY:-0}" = 1 ]; then return 0 2>/dev/null || exit 0; fi

log "--- launcher ${1:-gui}"
case "${1:-gui}" in
  gui|-psn_*) main_gui ;;
  start) start_stack ;;
  restart) ensure_root; load_ports; stop_stack; start_stack ;;
  open) ensure_root; load_ports; open_url "$WORKBENCH_URL" ;;
  stop) ensure_root; load_ports; stop_stack ;;
  stop-all) ensure_root; load_ports; stop_stack; stop_db_server ;;
  status) resolve_root; load_ports; status ;;
  logs) open_url "$LOG_DIR" ;;
  database) printf '%s %s@%s:%s/%s\n' "$(conf_get DB_LABEL)" "$(conf_get DB_USER)" "$(conf_get DB_HOST)" "$(conf_get DB_PORT)" "$(conf_get DB_NAME)" ;;
  choose-database) choose_database ;;
  install) install_bundle "${2:?usage: install <JEAuditFlow-$VERSION-Server-Install.tar.gz>}" ;;
  choose-root) ask_root "选择 JEAuditFlow $VERSION 程序目录。"; log "程序目录：$PROJECT_ROOT" ;;
  *) echo "usage: $SELF [start|stop|restart|stop-all|status|open|logs|database|choose-database|install <tar.gz>|choose-root]" >&2; exit 2 ;;
esac
