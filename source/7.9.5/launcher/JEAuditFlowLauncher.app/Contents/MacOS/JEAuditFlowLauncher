#!/bin/bash
# JEAuditFlow 7.9.5 launcher for macOS.
# Double-click: run this Mac as the JEAuditFlow 7.9.5 server (FileAnalyst,
# AuditFlow API and JiraFlow) on the MySQL connection already set up in
# TablePlus, then open the workbench. The normal path shows no dialogs.
# From Terminal:
#   JEAuditFlowLauncher.app/Contents/MacOS/JEAuditFlowLauncher
#     [start|stop|restart|stop-all|status|open|logs|database|choose-database|
#      install <JEAuditFlow-7.9.5-Server-Install.tar.gz>|choose-root]
# Must stay compatible with /bin/bash 3.2 (the macOS system bash).
set -u

VERSION=7.9.5
NODE_MIN=26.13.1
JAVA_MIN=21
DB_NAME_DEFAULT=jeauditflow_795
DEDICATED_DB_PORT=43327
DEDICATED_DB_USER=jeauditflow
ADMIN_EMAIL_DEFAULT=yumeng.li@johnsonelectric.com
BUNDLE_ID=local.maplemock.jeauditflowlauncher
TABLEPLUS_KEYCHAIN_SERVICES="com.tableplus.TablePlus com.tinyapp.TablePlus"
TAB="$(printf '\t')"
NL='
'

SELF="${BASH_SOURCE[0]:-$0}"
APP_CONTENTS="$(cd "$(dirname "$SELF")/.." && pwd)"
APP_BUNDLE="$(dirname "$APP_CONTENTS")"
RESOURCES="$APP_CONTENTS/Resources"
DB_TOOL="${JEAUDITFLOW_DB_TOOL:-$RESOURCES/db-tool.mjs}"
SUPPORT="${JEAUDITFLOW_SUPPORT_DIR:-$HOME/Library/Application Support/JEAuditFlow/$VERSION}"
LOG_DIR="${JEAUDITFLOW_LOG_DIR:-$HOME/Library/Logs/JEAuditFlow/$VERSION}"
TABLEPLUS_PLIST="${JEAUDITFLOW_TABLEPLUS_PLIST:-$HOME/Library/Application Support/com.tinyapp.TablePlus/Data/Connections.plist}"
RUN_DIR="$SUPPORT/run"
MYSQL_DIR="$SUPPORT/mysql"
SETTINGS="$SUPPORT/launcher.conf"
ROOT_FILE="$SUPPORT/project-root"
ADMIN_FILE="$SUPPORT/admin-login.txt"
LAUNCHER_LOG="$LOG_DIR/launcher.log"
PATH="$PATH:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

API_PORT=47983
FA_PORT=47984
JF_PORT=47985
WORKBENCH_URL="http://127.0.0.1:$API_PORT/index.html"
PROJECT_ROOT=""
PROJECT_BASE=""
PROJECT_CONFIG=""
NODE_BIN=""
JAVA_BIN=""
MYSQL_BIN_DIR=""
DB_SOURCE=""
DB_SECRET_REF=""
DB_LABEL=""
DB_HOST=""
DB_PORT=""
DB_USER=""
DB_PASSWORD=""
DB_NAME=""
TRY_REASON=""
CANDIDATES=""
USER_CHOSE=0
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
LAN_HOST=""
LAN_CIDR=""
SHOW_ADMIN=0
ALREADY_RUNNING=0

umask 077
mkdir -p "$SUPPORT" "$LOG_DIR" "$RUN_DIR"

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LAUNCHER_LOG"; printf '%s\n' "$*"; }

gui() { [ "${JEAUDITFLOW_LAUNCHER_NO_GUI:-0}" != 1 ] && command -v osascript >/dev/null 2>&1; }

as_quote() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# dialog [-t seconds] <message> [buttons...] (at most three buttons);
# prints the chosen button, or nothing when the dialog timed out.
dialog() {
  local timeout=""
  if [ "$1" = -t ]; then timeout="$2"; shift 2; fi
  local message="$1"; shift
  if ! gui; then
    printf '%s\n' "$message" >&2
    [ $# -gt 0 ] && printf '%s\n' "${JEAUDITFLOW_LAUNCHER_ANSWER:-$1}"
    return 0
  fi
  local buttons="" b
  [ $# -eq 0 ] && set -- "好"
  for b in "$@"; do buttons="$buttons${buttons:+, }\"$(as_quote "$b")\""; done
  osascript -e "button returned of (display dialog \"$(as_quote "$message")\" with title \"JEAuditFlow $VERSION\" buttons {$buttons} default button \"$(as_quote "$1")\" with icon note${timeout:+ giving up after $timeout})" 2>/dev/null
}

# choose_from_list <prompt> <items...>; prints the chosen item (empty when cancelled).
choose_from_list() {
  local prompt="$1" items="" item choice
  shift
  if ! gui; then printf '%s\n' "${JEAUDITFLOW_LAUNCHER_CHOICE:-$1}"; return 0; fi
  for item in "$@"; do items="$items${items:+, }\"$(as_quote "$item")\""; done
  choice="$(osascript -e "choose from list {$items} with prompt \"$(as_quote "$prompt")\" with title \"JEAuditFlow $VERSION\" default items {\"$(as_quote "$1")\"}" 2>/dev/null)"
  [ "$choice" = false ] || printf '%s\n' "$choice"
}

ask_password() {
  osascript -e "text returned of (display dialog \"$(as_quote "$1")\" with title \"JEAuditFlow $VERSION\" default answer \"\" with hidden answer buttons {\"跳过\", \"连接\"} default button \"连接\" cancel button \"跳过\")" 2>/dev/null
}

notify() {
  log "$1"
  gui && osascript -e "display notification \"$(as_quote "$1")\" with title \"JEAuditFlow $VERSION\"" >/dev/null 2>&1
  return 0
}

open_url() { if command -v open >/dev/null 2>&1; then open "$1"; else log "请在浏览器中打开 $1"; fi; }

fail() {
  log "错误：$1"
  if gui && [ "$(dialog "$1" "关闭" "打开日志")" = "打开日志" ]; then open_url "$LOG_DIR"; fi
  exit 1
}

choose_folder() {
  gui || { printf '%s\n' "${JEAUDITFLOW_LAUNCHER_CHOICE:-}"; return 0; }
  osascript -e "POSIX path of (choose folder with prompt \"$(as_quote "$1")\")" 2>/dev/null | sed 's#/$##'
}

choose_file() {
  gui || { printf '%s\n' "${JEAUDITFLOW_LAUNCHER_CHOICE:-}"; return 0; }
  osascript -e "POSIX path of (choose file with prompt \"$(as_quote "$1")\")" 2>/dev/null
}

expand_home() { case "$1" in \~) printf '%s\n' "$HOME" ;; \~/*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;; *) printf '%s\n' "$1" ;; esac; }

version_ge() {
  awk -v a="$1" -v b="$2" 'BEGIN { split(a, x, "."); split(b, y, ".");
    for (i = 1; i <= 3; i++) { if (x[i] + 0 > y[i] + 0) exit 0; if (x[i] + 0 < y[i] + 0) exit 1 } exit 0 }'
}

random_hex() { openssl rand -hex "$1"; }

port_ok() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }

# --- settings (KEY=VALUE, mode 600) -------------------------------------------
conf_get() { [ -f "${2:-$SETTINGS}" ] && sed -n "s/^$1=//p" "${2:-$SETTINGS}" | tail -n 1; }

conf_set() {
  local tmp="$SETTINGS.tmp.$$"
  { [ -f "$SETTINGS" ] && grep -v "^$1=" "$SETTINGS"; printf '%s=%s\n' "$1" "$2"; } >"$tmp" && mv -f "$tmp" "$SETTINGS"
  chmod 600 "$SETTINGS"
}

conf_unset() {
  [ -f "$SETTINGS" ] || return 0
  grep -v "^$1=" "$SETTINGS" >"$SETTINGS.tmp.$$"
  mv -f "$SETTINGS.tmp.$$" "$SETTINGS"
}

unquote() {
  local value="$1"
  case "$value" in
    \"*\") value="${value#\"}"; value="${value%\"}" ;;
    \'*\') value="${value#\'}"; value="${value%\'}" ;;
  esac
  printf '%s\n' "$value"
}

env_get() { unquote "$(conf_get "$1" "$2")"; }

# --- program directory ---------------------------------------------------------
root_valid() {
  [ -n "$1" ] && [ -f "$1/server/server.mjs" ] && [ -f "$1/fileanalyst/server.mjs" ] &&
    [ -f "$1/jiraflow/jiraflow.jar" ] && [ -f "$1/client/index.html" ] && [ -d "$1/server/node_modules/mysql2" ]
}

# Accepts the installed 7.9.5 directory itself, or a 7.x project checkout that
# keeps versions under local-deploy/runtime/versions/7.9.5.
normalize_root() {
  local candidate
  for candidate in "$1" "$1/local-deploy/runtime/versions/$VERSION" "$1/$VERSION"; do
    if root_valid "$candidate"; then printf '%s\n' "$candidate"; return 0; fi
  done
  return 1
}

# The 7.7 Swift launcher shares this bundle id and remembered the project folder.
legacy_project_root() { command -v defaults >/dev/null 2>&1 && defaults read "$BUNDLE_ID" projectRoot 2>/dev/null; return 0; }

root_hints() {
  printf '%s\n' "${JEAUDITFLOW_ROOT:-}"
  [ -f "$ROOT_FILE" ] && cat "$ROOT_FILE"
  [ -f "$RESOURCES/default-project-root.txt" ] && cat "$RESOURCES/default-project-root.txt"
  legacy_project_root
  printf '%s\n' "$HOME/JEAuditFlow/$VERSION"
}

# Project config written by local-deploy/scripts/jeauditflow-local.sh for this release.
project_config_for() {
  local file database
  for file in "$1/local-deploy/config/$VERSION.local.env" "$1/local-deploy/config/${VERSION%.*}.local.env"; do
    [ -f "$file" ] || continue
    database="$(env_get MYSQL_DATABASE "$file")"
    case "$database" in *795*) printf '%s\n' "$file"; return 0 ;; esac
  done
  return 1
}

set_root() {
  PROJECT_ROOT="$1"
  printf '%s\n' "$PROJECT_ROOT" >"$ROOT_FILE"
  PROJECT_BASE=""
  PROJECT_CONFIG=""
  case "$PROJECT_ROOT" in
    */local-deploy/runtime/versions/"$VERSION")
      PROJECT_BASE="${PROJECT_ROOT%/local-deploy/runtime/versions/"$VERSION"}"
      PROJECT_CONFIG="$(project_config_for "$PROJECT_BASE")" ;;
  esac
  return 0
}

resolve_root() {
  local candidate found
  while IFS= read -r candidate; do
    candidate="$(expand_home "$candidate")"
    [ -n "$candidate" ] || continue
    if found="$(normalize_root "$candidate")"; then set_root "$found"; return 0; fi
  done <<EOF
$(root_hints)
EOF
  return 1
}

install_target() {
  local target
  target="$(expand_home "$(head -n 1 "$RESOURCES/default-project-root.txt" 2>/dev/null)")"
  printf '%s\n' "${target:-$HOME/JEAuditFlow/$VERSION}"
}

# Newest JEAuditFlow-7.9.5-Server-Install.tar.gz next to the app, in
# Downloads/Desktop, or in the legacy project's release artifacts.
find_install_bundle() {
  local legacy dir found
  legacy="$(legacy_project_root)"
  while IFS= read -r dir; do
    [ -n "$dir" ] && [ -d "$dir" ] || continue
    found="$(ls -t "$dir/JEAuditFlow-$VERSION-Server-Install.tar.gz" "$dir"/*/"JEAuditFlow-$VERSION-Server-Install.tar.gz" 2>/dev/null | head -n 1)"
    [ -n "$found" ] && { printf '%s\n' "$found"; return 0; }
  done <<EOF
$(dirname "$APP_BUNDLE")
$HOME/Downloads
$HOME/Desktop
${legacy:+$legacy/artifacts/releases}
EOF
  return 1
}

install_bundle() {
  local bundle="$1" target work dir
  [ -f "$bundle" ] || fail "找不到安装包：$bundle"
  target="$(install_target)"
  work="$(mktemp -d "${TMPDIR:-/tmp}/jeauditflow-install.XXXXXX")"
  log "正在解压 $bundle"
  tar -xzf "$bundle" -C "$work" || fail "无法解压安装包（应为 JEAuditFlow-$VERSION-Server-Install.tar.gz）"
  dir="$work/JEAuditFlow-$VERSION-Server-Install"
  [ -f "$dir/SHA256SUMS.txt" ] || fail "安装包中缺少 SHA256SUMS.txt"
  (cd "$dir" && shasum -a 256 -c SHA256SUMS.txt >/dev/null 2>&1) || fail "安装包 SHA-256 校验失败"
  if [ -d "$target" ]; then mv "$target" "$target.previous-$(date +%Y%m%d%H%M%S)"; fi
  mkdir -p "$target/client" "$target/database"
  unzip -q "$dir/JEAuditFlow-$VERSION-Backend.zip" -d "$target" &&
    unzip -q "$dir/JEAuditFlow-$VERSION-Web-Client.zip" -d "$target/client" &&
    unzip -q "$dir/JEAuditFlow-$VERSION-Database.zip" -d "$target/database" || fail "解压程序文件失败"
  chmod +x "$target"/database/*.sh 2>/dev/null
  cp "$dir"/*.md "$target/" 2>/dev/null
  rm -rf "$work"
  xattr -dr com.apple.quarantine "$target" 2>/dev/null
  root_valid "$target" || fail "安装包内容不完整：$target"
  set_root "$target"
  log "已安装到 $PROJECT_ROOT"
}

ensure_root() {
  resolve_root && return 0
  local bundle
  if bundle="$(find_install_bundle)"; then
    notify "首次运行：正在安装 $(basename "$bundle")…"
    install_bundle "$bundle"
    return 0
  fi
  ask_root "未找到 JEAuditFlow $VERSION 程序目录。"
}

ask_root() {
  local choice path found
  choice="$(dialog "$1

请选择 JEAuditFlow-$VERSION-Server-Install.tar.gz 安装包（将安装到 $(install_target)），或选择已解压的 $VERSION 目录 / AuditFlowDesktop71 项目目录。" "选择安装包…" "选择已有目录…" "取消")"
  case "$choice" in
    "选择安装包…")
      path="$(choose_file "选择 JEAuditFlow-$VERSION-Server-Install.tar.gz")"
      [ -n "$path" ] || exit 0
      install_bundle "$path" ;;
    "选择已有目录…")
      path="$(choose_folder "选择 JEAuditFlow $VERSION 目录（包含 server、fileanalyst、jiraflow、client）或 7.x 项目目录")"
      [ -n "$path" ] || exit 0
      found="$(normalize_root "$path")" || fail "所选目录不是完整的 $VERSION 安装：$path"
      set_root "$found" ;;
    *) exit 0 ;;
  esac
}

load_ports() {
  local value
  if [ -n "$PROJECT_CONFIG" ]; then
    value="$(env_get AUDITFLOW_PORT "$PROJECT_CONFIG")"; port_ok "$value" && API_PORT="$value"
    FA_PORT=$((API_PORT + 1)); JF_PORT=$((API_PORT + 2))
    value="$(env_get FILEANALYST_PORT "$PROJECT_CONFIG")"; port_ok "$value" && FA_PORT="$value"
    value="$(env_get JIRAFLOW_PORT "$PROJECT_CONFIG")"; port_ok "$value" && JF_PORT="$value"
  fi
  if port_ok "${JEAUDITFLOW_API_PORT:-}"; then API_PORT="$JEAUDITFLOW_API_PORT"; FA_PORT=$((API_PORT + 1)); JF_PORT=$((API_PORT + 2)); fi
  WORKBENCH_URL="http://127.0.0.1:$API_PORT/index.html"
}

# --- runtimes --------------------------------------------------------------
toolchain_dirs() {
  [ -n "$PROJECT_BASE" ] && printf '%s\n' "$PROJECT_BASE/local-deploy/runtime/toolchains"
  printf '%s\n' "$HOME/JEAuditFlow/toolchains"
}

node_candidates() {
  local dir file
  printf '%s\n' "${JEAUDITFLOW_NODE:-}"
  while IFS= read -r dir; do
    for file in "$dir"/node-v*/bin/node; do printf '%s\n' "$file"; done
  done <<EOF
$(toolchain_dirs)
EOF
  printf '%s\n' /opt/homebrew/opt/node@26/bin/node /usr/local/opt/node@26/bin/node "$(command -v node 2>/dev/null)" \
    /opt/homebrew/bin/node /usr/local/bin/node
  for file in "$HOME"/.nvm/versions/node/v*/bin/node; do printf '%s\n' "$file"; done
}

find_node() {
  local candidate v
  while IFS= read -r candidate; do
    [ -n "$candidate" ] && [ -x "$candidate" ] || continue
    v="$("$candidate" -p process.versions.node 2>/dev/null </dev/null)" || continue
    if version_ge "$v" "$NODE_MIN"; then NODE_BIN="$candidate"; return 0; fi
  done <<EOF
$(node_candidates)
EOF
  return 1
}

java_candidates() {
  local dir file
  printf '%s\n' "${JEAUDITFLOW_JAVA:-}"
  while IFS= read -r dir; do
    for file in "$dir"/jdk-*/Contents/Home/bin/java "$dir"/jdk-*/bin/java; do printf '%s\n' "$file"; done
  done <<EOF
$(toolchain_dirs)
EOF
  file="$(/usr/libexec/java_home -v "$JAVA_MIN+" 2>/dev/null)"
  [ -n "$file" ] && printf '%s\n' "$file/bin/java"
  printf '%s\n' /opt/homebrew/opt/openjdk@21/bin/java /opt/homebrew/opt/openjdk/bin/java "$(command -v java 2>/dev/null)"
}

find_java() {
  local candidate major
  while IFS= read -r candidate; do
    [ -n "$candidate" ] && [ -x "$candidate" ] || continue
    major="$("$candidate" -XshowSettings:properties -version 2>&1 </dev/null | sed -n 's/.*java.specification.version = //p' | head -n 1)"
    [ -n "$major" ] || continue
    if [ "${major%%.*}" -ge "$JAVA_MIN" ] 2>/dev/null; then JAVA_BIN="$candidate"; return 0; fi
  done <<EOF
$(java_candidates)
EOF
  return 1
}

find_mysql_tools() {
  local candidate
  for candidate in "${JEAUDITFLOW_MYSQL_BIN_DIR:-}" /opt/homebrew/opt/mysql/bin /opt/homebrew/opt/mysql@8.4/bin \
      /usr/local/opt/mysql/bin /usr/local/opt/mysql@8.4/bin /usr/local/mysql/bin; do
    [ -n "$candidate" ] && [ -x "$candidate/mysqld" ] && { MYSQL_BIN_DIR="$candidate"; return 0; }
  done
  candidate="$(command -v mysqld 2>/dev/null)"
  [ -z "$candidate" ] && [ -x /usr/sbin/mysqld ] && candidate=/usr/sbin/mysqld
  [ -n "$candidate" ] || return 1
  MYSQL_BIN_DIR="$(dirname "$candidate")"
}

# --- database ----------------------------------------------------------------
port_open() {
  if command -v nc >/dev/null 2>&1; then nc -z -w 2 127.0.0.1 "$1" >/dev/null 2>&1
  else (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; fi
}

db_tool() {
  DB_HOST="$DB_HOST" DB_PORT="$DB_PORT" DB_USER="$DB_USER" DB_PASSWORD="$DB_PASSWORD" DB_NAME="$DB_NAME" \
    ADMIN_EMAIL="$ADMIN_EMAIL" JEAUDITFLOW_SERVER_DIR="$PROJECT_ROOT/server" "$NODE_BIN" "$DB_TOOL" "$@"
}

keychain_password() {
  local service
  command -v security >/dev/null 2>&1 || return 0
  for service in $TABLEPLUS_KEYCHAIN_SERVICES; do
    security find-generic-password -s "$service" -a "$1_database" -w 2>/dev/null && return 0
  done
  return 0
}

resolve_secret() {
  case "$1" in
    keychain:*) keychain_password "${1#keychain:}" ;;
    conf:*) env_get MYSQL_PASSWORD "${1#conf:}" ;;
    cnf:*) sed -n 's/^password=//p' "${1#cnf:}" | tail -n 1 ;;
  esac
}

# Candidate lines: score source secret-ref host port user database label (tab separated).
tableplus_candidates() {
  [ -f "$TABLEPLUS_PLIST" ] || return 0
  local score id host port user database name
  "${JEAUDITFLOW_PLUTIL:-plutil}" -convert xml1 -o - "$TABLEPLUS_PLIST" 2>>"$LAUNCHER_LOG" |
    "$NODE_BIN" "$DB_TOOL" tableplus 2>>"$LAUNCHER_LOG" |
    while IFS="$TAB" read -r score id host port user database name; do
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$score" tableplus "keychain:$id" "$host" "$port" "$user" "$database" "TablePlus「$name」"
    done
}

project_candidate() {
  [ -n "$PROJECT_CONFIG" ] || return 0
  local database port user
  database="$(env_get MYSQL_DATABASE "$PROJECT_CONFIG")"
  port="$(env_get DB_PORT "$PROJECT_CONFIG")"
  user="$(env_get MYSQL_USER "$PROJECT_CONFIG")"
  [ -n "$database" ] && [ -n "$user" ] && port_ok "$port" || return 0
  printf '95\tproject\tconf:%s\t127.0.0.1\t%s\t%s\t%s\t%s\n' "$PROJECT_CONFIG" "$port" "$user" "$database" "项目配置 ${PROJECT_CONFIG##*/}"
}

dedicated_candidate() {
  [ -f "$SUPPORT/mysql-client.cnf" ] || return 0
  printf '50\tdedicated\tcnf:%s\t127.0.0.1\t%s\t%s\t%s\t%s\n' "$SUPPORT/mysql-client.cnf" "$DEDICATED_DB_PORT" \
    "$(sed -n 's/^user=//p' "$SUPPORT/mysql-client.cnf" | tail -n 1)" "$DB_NAME_DEFAULT" "启动器专用 MySQL"
}

db_candidates() {
  { tableplus_candidates; project_candidate; dedicated_candidate; } | sort -t "$TAB" -k1,1nr
}

candidate_display() { printf '%s  %s@%s:%s/%s\n' "$8" "$6" "$4" "$5" "$7"; }

use_candidate() {
  DB_SOURCE="$2"; DB_SECRET_REF="$3"; DB_HOST="$4"; DB_PORT="$5"; DB_USER="$6"; DB_NAME="$7"; DB_LABEL="$8"
}

save_database() {
  conf_set DB_SOURCE "$DB_SOURCE"
  conf_set DB_SECRET_REF "$DB_SECRET_REF"
  conf_set DB_LABEL "$DB_LABEL"
  conf_set DB_HOST "$DB_HOST"
  conf_set DB_PORT "$DB_PORT"
  conf_set DB_USER "$DB_USER"
  conf_set DB_PASSWORD "$DB_PASSWORD"
  conf_set DB_NAME "$DB_NAME"
  log "使用数据库：$DB_LABEL（$DB_USER@$DB_HOST:$DB_PORT/$DB_NAME）"
}

load_saved_database() {
  DB_SOURCE="$(conf_get DB_SOURCE)"
  [ -n "$DB_SOURCE" ] || return 1
  DB_SECRET_REF="$(conf_get DB_SECRET_REF)"
  DB_LABEL="$(conf_get DB_LABEL)"
  DB_HOST="$(conf_get DB_HOST)"
  DB_PORT="$(conf_get DB_PORT)"
  DB_USER="$(conf_get DB_USER)"
  DB_PASSWORD="$(conf_get DB_PASSWORD)"
  DB_NAME="$(conf_get DB_NAME)"
}

forget_database() {
  local key
  for key in DB_SOURCE DB_SECRET_REF DB_LABEL DB_HOST DB_PORT DB_USER DB_PASSWORD DB_NAME; do conf_unset "$key"; done
}

# --- MySQL servers the launcher can start ---------------------------------------
# The project's own native MySQL for this release, same layout and socket as
# local-deploy/scripts/native-mysql.sh.
start_native_mysql() {
  local root="$1" port="$2" socket
  socket="/tmp/jeauditflow-mysql-$UID-$(printf '%s' "$root" | shasum -a 256 | cut -c1-16)/mysql.sock"
  [ -d "${socket%/*}" ] || mkdir -m 700 "${socket%/*}"
  log "启动项目内的 MySQL（$root，127.0.0.1:$port）"
  nohup "$MYSQL_BIN_DIR/mysqld" --no-defaults --datadir="$root/data" --port="$port" --bind-address=127.0.0.1 \
    --mysqlx=OFF --socket="$socket" --pid-file="$root/mysqld.pid" --log-error="$root/mysqld.log" \
    --max-allowed-packet=512M --innodb-buffer-pool-size=256M >/dev/null 2>&1 </dev/null &
  printf 'native:%s\n' "$root" >"$RUN_DIR/db-server"
}

start_dedicated_mysql() {
  [ -d "$MYSQL_DIR/data/mysql" ] || {
    log "首次初始化启动器专用 MySQL 数据目录 $MYSQL_DIR/data"
    mkdir -p "$MYSQL_DIR"
    "$MYSQL_BIN_DIR/mysqld" --no-defaults --initialize-insecure --basedir="$(dirname "$MYSQL_BIN_DIR")" --datadir="$MYSQL_DIR/data" \
      >>"$LOG_DIR/mysql-init.log" 2>&1 || fail "MySQL 初始化失败，详见 $LOG_DIR/mysql-init.log"
  }
  log "启动启动器专用 MySQL（127.0.0.1:$DEDICATED_DB_PORT）"
  nohup "$MYSQL_BIN_DIR/mysqld" --no-defaults --datadir="$MYSQL_DIR/data" --port="$DEDICATED_DB_PORT" \
    --bind-address=127.0.0.1 --socket="$MYSQL_DIR/mysql.sock" --mysqlx=OFF \
    --pid-file="$MYSQL_DIR/mysqld.pid" --log-error="$LOG_DIR/mysqld.log" \
    --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci >/dev/null 2>&1 </dev/null &
  printf 'dedicated\n' >"$RUN_DIR/db-server"
}

start_docker_mysql() {
  command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1 || return 1
  local id
  for id in $(docker ps -a --filter status=exited --filter status=created --format '{{.ID}}' 2>/dev/null); do
    docker inspect -f '{{range $p, $b := .HostConfig.PortBindings}}{{range $b}} {{.HostPort}}{{end}}{{end}}' "$id" 2>/dev/null |
      grep -qw "$1" || continue
    log "启动 Docker 容器 $(docker inspect -f '{{.Name}}' "$id" 2>/dev/null | sed 's#^/##')（端口 $1）"
    docker start "$id" >/dev/null 2>&1 || continue
    printf 'docker:%s\n' "$id" >"$RUN_DIR/db-server"
    return 0
  done
  return 1
}

start_brew_mysql() {
  command -v brew >/dev/null 2>&1 || return 1
  local formula
  formula="$(brew list --formula 2>/dev/null | grep -E '^(mysql|mariadb)(@[0-9.]+)?$' | head -n 1)"
  [ -n "$formula" ] || return 1
  log "启动 Homebrew $formula"
  brew services start "$formula" >>"$LAUNCHER_LOG" 2>&1 || return 1
  printf 'brew:%s\n' "$formula" >"$RUN_DIR/db-server"
}

start_db_server() {
  local port="$1" root
  if [ -n "$PROJECT_CONFIG" ] && [ "$(env_get DB_PORT "$PROJECT_CONFIG")" = "$port" ]; then
    root="$PROJECT_BASE/local-deploy/runtime/native-mysql/$VERSION"
    if [ -d "$root/data/mysql" ] && find_mysql_tools; then start_native_mysql "$root" "$port"; return 0; fi
  fi
  if [ "$port" = "$DEDICATED_DB_PORT" ] && [ -d "$MYSQL_DIR/data/mysql" ] && find_mysql_tools; then
    start_dedicated_mysql; return 0
  fi
  start_docker_mysql "$port" && return 0
  [ "$port" = 3306 ] && start_brew_mysql && return 0
  return 1
}

ensure_db_server() {
  local _
  port_open "$1" && return 0
  start_db_server "$1" || return 1
  for _ in $(seq 1 60); do port_open "$1" && return 0; sleep 1; done
  return 1
}

stop_db_server() {
  local owner pid
  owner="$(cat "$RUN_DIR/db-server" 2>/dev/null)"
  case "$owner" in
    native:*) pid="$(cat "${owner#native:}/mysqld.pid" 2>/dev/null)" ;;
    dedicated) pid="$(cat "$MYSQL_DIR/mysqld.pid" 2>/dev/null)" ;;
    docker:*) docker stop "${owner#docker:}" >/dev/null 2>&1 && log "已停止 Docker MySQL 容器" ;;
    brew:*) brew services stop "${owner#brew:}" >>"$LAUNCHER_LOG" 2>&1 && log "已停止 Homebrew ${owner#brew:}" ;;
    *) log "数据库服务器不是由启动器启动的，保持运行" ;;
  esac
  [ -n "${pid:-}" ] && kill "$pid" 2>/dev/null && log "已停止 MySQL（PID $pid）"
  rm -f "$RUN_DIR/db-server"
}

# Logs in with the current DB_* candidate; sets TRY_REASON on failure.
try_database() {
  local rc
  DB_PASSWORD="$(resolve_secret "$DB_SECRET_REF")"
  if ! ensure_db_server "$DB_PORT"; then
    TRY_REASON="$DB_LABEL：$DB_HOST:$DB_PORT 上没有运行中的 MySQL，启动器也无法自动启动它"
    return 1
  fi
  db_tool ping >/dev/null 2>>"$LAUNCHER_LOG"
  rc=$?
  # The Keychain item may be missing or named differently in other TablePlus builds.
  if [ "$rc" = 4 ] && [ "$DB_SOURCE" = tableplus ] && gui; then
    DB_PASSWORD="$(ask_password "启动器没能从钥匙串读取 $DB_LABEL 的密码。

请输入 $DB_USER@$DB_HOST:$DB_PORT 的 MySQL 密码（只保存在本机启动器配置中，权限 600）：")"
    db_tool ping >/dev/null 2>>"$LAUNCHER_LOG"
    rc=$?
  fi
  case "$rc" in
    0) return 0 ;;
    4) TRY_REASON="$DB_LABEL：账号 $DB_USER 被拒绝登录（TablePlus 中没有保存密码，或密码已变更）" ;;
    3) TRY_REASON="$DB_LABEL：无法连接 $DB_HOST:$DB_PORT" ;;
    *) TRY_REASON="$DB_LABEL：连接失败（详见 $LAUNCHER_LOG）" ;;
  esac
  return 1
}

# When several TablePlus connections match equally well, lets the user pick one
# and narrows CANDIDATES to it (USER_CHOSE=1).
pick_tied_candidate() {
  local top count chosen index=0 line
  USER_CHOSE=0
  top="$(printf '%s\n' "$CANDIDATES" | head -n 1 | cut -f1)"
  count="$(printf '%s\n' "$CANDIDATES" | awk -F "$TAB" -v top="$top" '$1 == top && $2 == "tableplus"' | wc -l | tr -d ' ')"
  { [ "${count:-0}" -gt 1 ] && gui; } || return 0
  set --
  while IFS= read -r line; do
    index=$((index + 1))
    case "$line" in "$top${TAB}tableplus$TAB"*) ;; *) continue ;; esac
    set -- "$@" "$index. $(IFS="$TAB"; set -f; candidate_display $line)"
  done <<EOF
$CANDIDATES
EOF
  chosen="$(choose_from_list "TablePlus 中有多个可用于 $VERSION 的本机 MySQL 连接，请选择要使用的一个：" "$@")"
  [ -n "$chosen" ] || exit 0
  CANDIDATES="$(printf '%s\n' "$CANDIDATES" | sed -n "${chosen%%.*}p")"
  USER_CHOSE=1
}

resolve_database() {
  local line tried="" rc score source secret host port user database label
  if load_saved_database; then
    ensure_db_server "$DB_PORT" || fail_database "上次使用的数据库 $DB_LABEL（$DB_HOST:$DB_PORT）没有在运行，启动器也无法自动启动它。请先在 TablePlus 对应的 MySQL（Docker、Homebrew 或项目内实例）启动后再打开启动器。"
    db_tool ping >/dev/null 2>>"$LAUNCHER_LOG"
    rc=$?
    [ "$rc" = 0 ] && return 0
    if [ "$rc" = 4 ] && try_database; then save_database; return 0; fi
    fail_database "无法登录上次使用的数据库 $DB_LABEL（$DB_USER@$DB_HOST:$DB_PORT）。如果在 TablePlus 中修改过密码，请在 TablePlus 中保存新密码后重新打开启动器。"
  fi
  CANDIDATES="$(db_candidates)"
  [ -n "$CANDIDATES" ] && pick_tied_candidate
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    IFS="$TAB" read -r score source secret host port user database label <<EOF
$line
EOF
    use_candidate "$score" "$source" "$secret" "$host" "$port" "$user" "$database" "$label"
    if try_database </dev/null; then save_database; return 0; fi
    [ "$USER_CHOSE" = 1 ] && fail_database "$TRY_REASON"
    log "跳过 $TRY_REASON"
    tried="$tried$NL- $TRY_REASON"
  done <<EOF
$CANDIDATES
EOF
  if find_mysql_tools; then setup_dedicated_database; return 0; fi
  if [ -n "$tried" ]; then
    fail "找到了这些本机 MySQL 连接，但都无法使用：$tried"
  fi
  fail "没有在 TablePlus 中找到本机（127.0.0.1 / localhost）的 MySQL 连接。请先在 TablePlus 中添加并保存一个连接（含密码），或执行 brew install mysql 让启动器自建数据库。"
}

fail_database() {
  log "错误：$1"
  if gui; then
    case "$(dialog "$1" "关闭" "重新选择数据库" "打开日志")" in
      "重新选择数据库") forget_database; exec "$SELF" ;;
      "打开日志") open_url "$LOG_DIR" ;;
    esac
  fi
  exit 1
}

# Last resort when no usable connection exists: a MySQL instance owned by the
# launcher on 127.0.0.1:43327 with generated credentials.
setup_dedicated_database() {
  local app_password root_password
  if [ ! -f "$SUPPORT/mysql-client.cnf" ]; then
    port_open "$DEDICATED_DB_PORT" && fail "端口 $DEDICATED_DB_PORT 已被另一个 MySQL 占用，且启动器没有它的账号。请在 TablePlus 中为它保存连接，或停止该实例。"
    ensure_db_server "$DEDICATED_DB_PORT" || start_dedicated_mysql
    local _
    for _ in $(seq 1 60); do port_open "$DEDICATED_DB_PORT" && break; sleep 1; done
    port_open "$DEDICATED_DB_PORT" || fail "MySQL 未能在 60 秒内启动，详见 $LOG_DIR/mysqld.log"
    app_password="$(random_hex 18)"
    root_password="$(random_hex 18)"
    DB_HOST=127.0.0.1; DB_PORT="$DEDICATED_DB_PORT"; DB_USER=root; DB_PASSWORD=""; DB_NAME="$DB_NAME_DEFAULT"
    APP_USER="$DEDICATED_DB_USER" APP_PASSWORD="$app_password" NEW_ROOT_PASSWORD="$root_password" \
      db_tool provision >>"$LAUNCHER_LOG" 2>&1 || fail "初始化启动器专用 MySQL 失败，详见 $LAUNCHER_LOG"
    printf '[client]\nuser=%s\npassword=%s\n' "$DEDICATED_DB_USER" "$app_password" >"$SUPPORT/mysql-client.cnf"
    printf '[client]\nuser=root\npassword=%s\n' "$root_password" >"$SUPPORT/mysql-root.cnf"
    chmod 600 "$SUPPORT/mysql-client.cnf" "$SUPPORT/mysql-root.cnf"
  fi
  use_candidate 50 dedicated "cnf:$SUPPORT/mysql-client.cnf" 127.0.0.1 "$DEDICATED_DB_PORT" "$DEDICATED_DB_USER" "$DB_NAME_DEFAULT" "启动器专用 MySQL"
  try_database || fail "$TRY_REASON"
  save_database
}

