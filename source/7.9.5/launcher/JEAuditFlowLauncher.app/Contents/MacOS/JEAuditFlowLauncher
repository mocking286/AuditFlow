# --- Wi-Fi (LAN) access ---------------------------------------------------------
# Prints network/prefix for a private IPv4 address; the prefix is kept within /16../30.
lan_cidr() {
  awk -v ip="$1" -v mask="$2" '
    function band(x, y,   r, bit, i) { r = 0; bit = 1; for (i = 0; i < 8; i++) { if (x % 2 == 1 && y % 2 == 1) r += bit; x = int(x / 2); y = int(y / 2); bit *= 2 } return r }
    BEGIN {
      if (split(ip, a, ".") != 4 || split(mask, m, ".") != 4) exit 1
      for (i = 1; i <= 4; i++) if (a[i] !~ /^[0-9]+$/ || a[i] > 255 || m[i] !~ /^[0-9]+$/ || m[i] > 255) exit 1
      if (!(a[1] == 10 || (a[1] == 172 && a[2] >= 16 && a[2] <= 31) || (a[1] == 192 && a[2] == 168))) exit 1
      bits = 0
      for (i = 1; i <= 4; i++) { x = m[i] + 0; while (x > 0) { bits += x % 2; x = int(x / 2) } }
      if (bits > 30) exit 1
      if (bits < 16) bits = 16
      for (i = 1; i <= 4; i++) {
        n = bits - 8 * (i - 1)
        octet = n >= 8 ? 255 : n <= 0 ? 0 : 256 - 2 ^ (8 - n)
        net[i] = band(a[i] + 0, octet)
      }
      printf "%d.%d.%d.%d/%d\n", net[1], net[2], net[3], net[4], bits
    }'
}

mask_from_hex() {
  local hex="${1#0x}"
  [ ${#hex} = 8 ] || return 1
  printf '%d.%d.%d.%d\n' "$((16#${hex:0:2}))" "$((16#${hex:2:2}))" "$((16#${hex:4:2}))" "$((16#${hex:6:2}))"
}

detect_lan() {
  local iface ip mask cidr
  LAN_HOST=""
  LAN_CIDR=""
  case "${JEAUDITFLOW_LAN:-$(conf_get LAN)}" in off|0|false|no) return 1 ;; esac
  if [ -n "${JEAUDITFLOW_LAN_HOST:-}" ]; then
    cidr="$(lan_cidr "$JEAUDITFLOW_LAN_HOST" "${JEAUDITFLOW_LAN_MASK:-255.255.255.0}")" || return 1
    LAN_HOST="$JEAUDITFLOW_LAN_HOST"; LAN_CIDR="$cidr"; return 0
  fi
  command -v ipconfig >/dev/null 2>&1 || return 1
  for iface in $(route -n get default 2>/dev/null | awk '/interface:/ { print $2; exit }') en0 en1; do
    ip="$(ipconfig getifaddr "$iface" 2>/dev/null)"
    [ -n "$ip" ] || continue
    mask="$(ipconfig getoption "$iface" subnet_mask 2>/dev/null)"
    [ -n "$mask" ] || mask="$(mask_from_hex "$(ifconfig "$iface" 2>/dev/null | awk -v ip="$ip" '$1 == "inet" && $2 == ip { print $4; exit }')")"
    cidr="$(lan_cidr "$ip" "${mask:-255.255.255.0}")" || continue
    LAN_HOST="$ip"; LAN_CIDR="$cidr"
    return 0
  done
  return 1
}

lan_url() { [ -n "$LAN_HOST" ] && printf 'http://%s:%s/\n' "$LAN_HOST" "$API_PORT"; }

