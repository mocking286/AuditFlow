ensure_app_database() {
  local state line database=0 schema=0 admin=0 dir rc
  state="$(db_tool inspect 2>>"$LAUNCHER_LOG")" || fail "无法读取数据库 $DB_NAME 的状态（$DB_LABEL），详见 $LAUNCHER_LOG"
  for line in $state; do
    case "$line" in database=*) database="${line#*=}" ;; schema=*) schema="${line#*=}" ;; admin=*) admin="${line#*=}" ;; esac
  done
  if [ "$database" != 1 ] || [ "$schema" != 1 ]; then
    dir="$(schema_dir)" || fail "程序目录中缺少 $VERSION 数据库结构文件（database/schema）"
    [ "$DB_SOURCE" = dedicated ] || confirm_database_write "$database"
    if [ "$database" != 1 ]; then
      db_tool create-database >>"$LAUNCHER_LOG" 2>&1
      rc=$?
      [ "$rc" = 4 ] && fail "账号 $DB_USER 没有创建数据库的权限。请在 TablePlus 中用管理员账号执行：
CREATE DATABASE $DB_NAME CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
GRANT ALL PRIVILEGES ON $DB_NAME.* TO '$DB_USER'@'localhost';
然后重新打开启动器。"
      [ "$rc" = 0 ] || fail "创建数据库 $DB_NAME 失败，详见 $LAUNCHER_LOG"
    fi
    db_tool apply-schema "$dir" >>"$LAUNCHER_LOG" 2>&1 || fail "在 $DB_NAME 中创建数据表失败，详见 $LAUNCHER_LOG"
    log "数据库 $DB_NAME 已就绪（$DB_LABEL）"
  fi
  [ "$admin" = 1 ] || SHOW_ADMIN=1
}

